#!/bin/spsl
# omv-tour.spsl: a read-only walk around an OpenMediaVault server, to try SPSL's EXPECT, WAITFOR /re, /i and
# /else:, labels, GOTO and STOP. It only looks (echo, id, grep, cd, ls, df, uname, sleep); nothing is changed.
#
# Markers: a command ends by printing, say, MARK-$((6*7)), and the script waits for MARK-42. The shell works the sum
# out, so the command line itself (which the terminal echoes as it's typed) never matches; only the shell's answer.
# The prompt is any line ending in # or $ (root's and a user's bash prompt).

# ---- 1. Find a prompt to start from -----------------------------------------------------------------------------
SENDLINE
WAITFOR /t:5 /re /else:noprompt [#$]\s*$

# ---- 2. Who are we? EXPECT picks whichever case appears first ---------------------------------------------------
SENDLINE echo "ROLE-$(id -un)"
EXPECT /t:5 /else:noprompt
  CASE /ROLE-root\b/
    WAITFOR /re [#$]\s*$
    SENDLINE echo "Running as root: the tour still only reads."
  CASE /ROLE-[a-z_][a-z0-9_-]*/
    WAITFOR /re [#$]\s*$
    SENDLINE echo "Running as an ordinary user: some folders may be closed to us."
END
WAITFOR /re [#$]\s*$

# ---- 3. Which system? /i on EXPECT makes every case ignore case; ^ and $ are a line's start and end -----------
SENDLINE grep -i '^ID=' /etc/os-release; echo "OS-$((1+1))"
EXPECT /t:5 /i
  CASE /^ID=debian$/
    WAITFOR /re [#$]\s*$
    SENDLINE echo "Debian underneath, as OpenMediaVault is."
  CASE /^ID=/
    WAITFOR /re [#$]\s*$
    SENDLINE echo "Not Debian, but carrying on."
  CASE OS-2
    WAITFOR /re [#$]\s*$
    SENDLINE echo "No /etc/os-release here."
END
WAITFOR /re [#$]\s*$

# ---- 4. Is OpenMediaVault installed? NOOMV-5 also contains OMV-5, but it starts earlier in the output, so it wins
SENDLINE command -v omv-confdbadm >/dev/null && echo "OMV-$((2+3))" || echo "NOOMV-$((2+3))"
EXPECT /t:5 /else:noprompt
  CASE NOOMV-5
    WAITFOR /re [#$]\s*$
    SENDLINE echo "No OpenMediaVault tools: skipping its settings folder."
    WAITFOR /re [#$]\s*$
    GOTO disks
  CASE OMV-5
    WAITFOR /re [#$]\s*$
END

# ---- 5. Its settings folder: in, or not allowed ------------------------------------------------------------------
SENDLINE cd /etc/openmediavault 2>/dev/null && echo "IN-$((7*6))" || echo "OUT-$((7*6))"
EXPECT /t:5
  CASE IN-42
    WAITFOR /re [#$]\s*$
    SENDLINE pwd; ls -la | head -15
  CASE OUT-42
    WAITFOR /re [#$]\s*$
    SENDLINE echo "Can't go into /etc/openmediavault (not root?)."
END
WAITFOR /re [#$]\s*$

# ---- 6. The data disks, which OpenMediaVault mounts as /srv/dev-disk-by-... ------------------------------------
:disks
SENDLINE ls -d /srv/dev-disk-by-* 2>/dev/null; echo "DISKS-$((3*3))"
EXPECT /t:5
  # ^ keeps the typed command (it starts with the prompt) from matching: only ls's own lines start with /srv
  CASE /^\/srv\/dev-disk-by-/
    WAITFOR DISKS-9
    WAITFOR /re [#$]\s*$
    SENDLINE cd "$(ls -d /srv/dev-disk-by-* | head -1)" && pwd && ls -la | head -20
    WAITFOR /re [#$]\s*$
  CASE DISKS-9
    WAITFOR /re [#$]\s*$
    SENDLINE echo "No /srv/dev-disk-by-* disks mounted."
    WAITFOR /re [#$]\s*$
END

# ---- 7. Any filesystem over 90% full? -----------------------------------------------------------------------------
SENDLINE df -h --output=pcent,target -x tmpfs -x devtmpfs | tail -n +2 | sort -rn | head -5; echo "DF-$((4*4))"
EXPECT /t:10
  CASE /^\s*(9[0-9]|100)%/
    WAITFOR DF-16
    WAITFOR /re [#$]\s*$
    SENDLINE echo "Heads up: a filesystem is over 90% full (top of the list above)."
  CASE DF-16
    WAITFOR /re [#$]\s*$
    SENDLINE echo "Every filesystem has room."
END
WAITFOR /re [#$]\s*$

# ---- 8. Docker, if it's there: a look at the containers ---------------------------------------------------------
SENDLINE command -v docker >/dev/null && echo "DOCKER-$((5+5))" || echo "NODOCKER-$((5+5))"
EXPECT /t:5
  CASE NODOCKER-10
    WAITFOR /re [#$]\s*$
    GOTO slow
  CASE DOCKER-10
    WAITFOR /re [#$]\s*$
    SENDLINE docker ps -a 2>&1 | head -10
    WAITFOR /re [#$]\s*$
END

# ---- 9. A timeout that doesn't stop the script: /else: goes to a label instead --------------------------------
:slow
SENDLINE sleep 3; echo "SLOW-$((9*9))"
WAITFOR /t:1 /else:tooslow SLOW-81
SENDLINE echo "That was quick."
GOTO kernel
:tooslow
WAITFOR /t:10 /else:noprompt SLOW-81
WAITFOR /re [#$]\s*$
SENDLINE echo "Waited past the first timeout, then carried on."

# ---- 10. /i: uname prints Linux; the script asks for linux ------------------------------------------------------
:kernel
WAITFOR /re [#$]\s*$
SENDLINE uname -s
WAITFOR /t:5 /i /else:continue linux
WAITFOR /re [#$]\s*$
SENDLINE cd ~ && echo "Tour finished, back home."
WAITFOR /re [#$]\s*$
GOTO done

# ---- When there's no prompt, say so and stop -------------------------------------------------------------------
:noprompt
STOP No shell prompt (a line ending in # or $) appeared: is this tab at a Linux shell?

:done
