{
  "name": "superxterminal",
  "version": "0.7.0",
  "description": "A macOS counterpart of SuperXPuTTY: its sessions tree, Database sessions, icons, colours and tabs, with SSH through OpenSSH",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "licenses": "node scripts/check-licenses.mjs",
    "notices": "node scripts/notices.mjs",
    "release:version": "node scripts/set-version.mjs",
    "release:checks": "npm run check && npm test && npm run test:browser && npm run licenses && cargo test --manifest-path src-tauri/Cargo.toml && cargo deny --manifest-path src-tauri/Cargo.toml check",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "build:linux": "bash scripts/build-linux.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "dockview-core": "^8.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/svelte": "^5.0.8",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
