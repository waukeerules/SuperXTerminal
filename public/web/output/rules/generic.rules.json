{
  "id": "generic",
  "name": "Generic",
  "description": "Addresses and error words in any output. The Cisco and Junos sets include these rules.",
  "rules": [
    { "match": "\\b(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}(?:/\\d{1,2})?\\b", "style": "address" },
    { "match": "\\b[0-9a-fA-F]{4}\\.[0-9a-fA-F]{4}\\.[0-9a-fA-F]{4}\\b", "style": "mac" },
    { "match": "\\b(?:[0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}\\b", "style": "mac" },
    { "match": "\\b(?:[0-9a-fA-F]{1,4}:){3,7}[0-9a-fA-F]{1,4}(?:/\\d{1,3})?\\b|\\b(?:[0-9a-fA-F]{1,4}:){1,6}:(?:[0-9a-fA-F]{1,4})?(?:/\\d{1,3})?", "style": "address" },
    { "match": "\\b(error|failed|failure|denied|refused|unreachable|timed out|invalid)\\b", "style": "bad", "ignoreCase": true },
    { "match": "\\b(warning|warn)\\b", "style": "warning", "ignoreCase": true }
  ]
}
