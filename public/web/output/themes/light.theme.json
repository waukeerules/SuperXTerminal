    "bad": { "color": "#cf222e", "bold": true },
    "warning": { "color": "#9a6700" },
    "info": { "color": "#0550ae" },
    "address": { "color": "#0e7490" },
    "mac": { "color": "#8250df" },
    "prompt": { "color": "#795e26", "bold": true },
    "keyword": { "color": "#0000ff", "bold": true },
    "comment": { "color": "#008000", "italic": true }
