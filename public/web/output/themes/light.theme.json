{
  "name": "Light",
  "base": "vs",
  "colors": {
    "background": "#ffffff",
    "foreground": "#1f1f1f",
    "selection": "#add6ff",
    "lineNumbers": "#8a8a8a",
    "currentLine": "#f3f3f3"
  },
  "font": { "family": "Consolas, \"Courier New\", monospace", "size": 13 },
  "styles": {
