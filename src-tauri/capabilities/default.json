{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and those New Window makes",
  "windows": [
    "main",
    "window-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-save",
    "core:window:allow-request-user-attention"
  ]
}
